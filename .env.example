# WintrChess environment configuration
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env

# Basic Settings
# "production" for deployed builds, "development" for local dev tooling
NODE_ENV="production"
# Port the server listens on (defaults to 8080 if unset)
PORT=8888
# Public origin of the site — must match the address you browse, and must be
# set for authentication to initialise (e.g. "https://wintrchess.com")
ORIGIN="http://localhost:8888"

# Database Configuration
# MongoDB connection string; also used by docker/podman container setups.
# Use 127.0.0.1 (not "localhost") when running the DB in a local container,
# since "localhost" may resolve to an IPv6 address the container port is not bound to.
DATABASE_URI="mongodb://127.0.0.1:27017/wintrchess"

# Application Settings
# Number of analysis actions (engine eval requests) allowed per session token
ANALYSIS_SESSION_ACTIONS=80
# Maximum number of games a user may keep in their archive
MAXIMUM_ARCHIVE_SIZE=50
# Password for internal/admin routes (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
INTERNAL_PASSWORD="replace-with-a-strong-random-string"

# Authentication
# Secret used to sign sessions, CAPTCHA HMACs and analysis-session payloads.
# Required: change this to a strong random string with good entropy
AUTH_SECRET="replace-with-a-strong-random-string"

# OAuth (optional)
# Enables Google sign-in; leave commented out to disable the provider
# GOOGLE_OAUTH_CLIENT_ID="your-google-client-id"
# GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret"

# Optional Services
# Google AdSense publisher id and analytics measurement id, if monetising
# ADS_PUBLISHER_ID="ca-pub-XXXXXXXXXXXXXXXX"
# ANALYTICS_MEASUREMENT_ID="G-XXXXXXXXXX"

# Email Settings (optional)
# Required only for transactional (no-reply) email sending
# EMAIL_ACCOUNT="contact@yourdomain.com"
# AUTOMATED_EMAIL_ADDRESS="no-reply@yourdomain.com"
# AUTOMATED_EMAIL_KEY="your-email-key-here"
