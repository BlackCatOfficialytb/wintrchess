# Basic Settings
NODE_ENV="development"
PORT=8080
ORIGIN="http://localhost:8080"

# Database Configuration
# Choose your backend by setting DB_TYPE:
#   - "mongodb" (default): uses DATABASE_URI below
#   - "sql": uses DATABASE_URL below (SQLite, MySQL or PostgreSQL)
DB_TYPE="sql"

# MongoDB (used when DB_TYPE is "mongodb" or unset)
# DATABASE_URI="mongodb://username:password@localhost:27017/wintrchess"

# SQL - SQLite (no server needed, creates ./data/wintrchess.db)
DATABASE_URL="./data/wintrchess.db"

# SQL - PostgreSQL (uncomment to use)
# DATABASE_URL="postgresql://username:password@localhost:5432/wintrchess"

# SQL - MySQL / MariaDB (uncomment to use)
# DATABASE_URL="mysql://username:password@localhost:3306/wintrchess"

# Application Settings
ANALYSIS_SESSION_ACTIONS=80
MAXIMUM_ARCHIVE_SIZE=50
INTERNAL_PASSWORD="squidward"
TRUSTED_ORIGINS="http://localhost:8080,https://wintrchess.com"

# Authentication
AUTH_SECRET="12345678901234567890123456789012"

# OAuth (optional)
# GOOGLE_OAUTH_CLIENT_ID="your-google-client-id"
# GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret"

# Optional Services
ADS_PUBLISHER_ID="ca-pub-3914142339921252"
ANALYTICS_MEASUREMENT_ID="G-EX024ZXSNX"

# Email Settings
EMAIL_ACCOUNT="contact@wintrchess.com"
AUTOMATED_EMAIL_ADDRESS="no-reply@wintrchess.com"
AUTOMATED_EMAIL_KEY="your-email-key-here"
